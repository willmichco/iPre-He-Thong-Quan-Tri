# Chép thành .env.local rồi điền. KHÔNG commit file .env.local.

# Cơ sở dữ liệu (máy phát triển: docker compose up -d)
DATABASE_URL=postgres://ipre:ipre_dev@localhost:5432/ipre

# Tài khoản chủ — tạo bằng: npm run auth:setup -- --email ban@example.com
# Để trống cả 4 dòng khi phát triển: ứng dụng cho vào thẳng (kèm cảnh báo).
# Môi trường thật (production) bắt buộc đủ cả 4, nếu không sẽ không vào được.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
SESSION_SECRET=
