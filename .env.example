# Chép thành .env.local rồi điền. KHÔNG commit file .env.local.

# Cơ sở dữ liệu (máy phát triển: docker compose up -d)
DATABASE_URL=postgres://ipre:ipre_dev@localhost:5432/ipre

# Tài khoản chủ — tạo bằng: npm run auth:setup -- --email ban@example.com
# Để trống cả 4 dòng khi phát triển: ứng dụng cho vào thẳng (kèm cảnh báo).
# Môi trường thật (production) bắt buộc đủ cả 4, nếu không sẽ không vào được.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
SESSION_SECRET=

# Bot theo dõi vận đơn (2 lần / ngày). Cần ít nhất một nguồn — chỉ dùng API chính thức, không cào web hãng.
#   UPS: tạo ứng dụng miễn phí ở developer.ups.com (sản phẩm "Tracking") → Client ID + Client Secret
#   17TRACK: api.17track.net → khoá API (UPS, USPS, FedEx, DHL và nhiều forwarder)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
TRACK17_API_KEY=
# Cron gọi POST /api/cron/theo-doi-van-don kèm "Authorization: Bearer <CRON_SECRET>" (≥ 32 ký tự ngẫu nhiên),
# hoặc chạy `npm run tracking` bằng cron máy chủ: 0 0,12 * * *  (07:00 và 19:00 giờ VN)
CRON_SECRET=
